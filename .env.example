# ==============================================
# 塗装業界ニュース自動まとめツール — 環境変数設定
# ==============================================
# このファイルをコピーして .env にリネームし、
# 各APIキーと設定値を入力してください。
#
#   cp .env.example .env
#
# 注意: .env ファイルはGitにコミットしないでください！

# ── NewsAPI ──
# https://newsapi.org/ で無料APIキーを取得
NEWSAPI_KEY=your_newsapi_key_here

# ── Claude API (Anthropic) ──
# https://console.anthropic.com/ でAPIキーを取得
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── SendGrid ──
# https://sendgrid.com/ で無料アカウント作成後、APIキーを取得
# ※ 現在は SendGrid 未使用（SMTP 直接接続に変更）
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# ── メール設定（SMTP 汎用） ──
# 送信元メールアドレス
FROM_EMAIL=news@yourdomain.co.jp

# SMTP サーバーのホスト名（社内メールサーバーのアドレス）
# 例: mail.yourdomain.co.jp
SMTP_HOST=mail.yourdomain.co.jp

# SMTP ポート番号
# 587 = STARTTLS（推奨）/ 465 = SSL / 25 = 認証なし（非推奨）
SMTP_PORT=587

# SMTP 認証ユーザー名（省略時は FROM_EMAIL が使用される）
# メールアドレス形式の場合: news@yourdomain.co.jp
# ユーザー名のみの場合: news
SMTP_USER=news@yourdomain.co.jp

# SMTP パスワード
SMTP_PASSWORD=your_smtp_password_here

# ── Gmail を使う場合（旧設定・後方互換） ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_account@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx   ← Googleアカウントのアプリパスワード

# 通知先メールアドレス（レポートリンクの送信先）
# カンマ区切りで複数指定可: a@example.com,b@example.com
NOTIFY_EMAIL=your_email@example.com

# ── GitHub Pages ──
# GitHub Pages で公開する場合のベースURL
# 例: https://username.github.io/paint-news-app/
PAGES_BASE_URL=https://your-username.github.io/paint-news-app/

# ── ログレベル ──
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
